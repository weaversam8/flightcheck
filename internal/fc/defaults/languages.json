{
  "elixir": {
    "extensions": [".ex", ".exs", ".heex", ".eex", ".leex"],
    "blocks_file": "elixir.md",
    "comments": {
      "default": ["#", ""],
      ".heex": ["<%!--", "--%>"],
      ".eex": ["<%#", "%>"],
      ".leex": ["<%#", "%>"]
    },
    "skip_blocks": ["pattern_matching", "pipelines"]
  },
  "go": {
    "extensions": [".go"],
    "blocks_file": "go.md",
    "comments": { "default": ["//", ""] },
    "skip_blocks": []
  },
  "shell": {
    "extensions": [".sh", ".bash"],
    "blocks_file": "shell.md",
    "comments": { "default": ["#", ""] },
    "skip_blocks": ["quoting"]
  }
}
